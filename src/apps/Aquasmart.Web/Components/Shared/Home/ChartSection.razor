@using Aquasmart.Web.Core.Models
@inject LeituraService LeituraService
@inject HttpClient Http
@implements IDisposable

<div class="lg:col-span-2 bg-gradient-to-br from-gray-900 to-gray-950 rounded-2xl p-5 border border-gray-800">
    <div class="flex justify-between items-center mb-4">
        <h3 class="font-semibold text-white flex items-center gap-2">
            <div class="w-1 h-6 bg-blue-500 rounded-full"></div>
            <i class="fa-solid fa-chart-line text-blue-500"></i>
            Temperatura - Últimas Leituras
        </h3>
        <div class="text-xs @(_isConnected ? "text-green-400" : "text-red-400")">
            <i class="fa-solid fa-circle text-[8px] animate-pulse mr-1"></i>
            @(_isConnected ? "Conectado" : "Desconectado")
        </div>
    </div>
    
    @if (_leituras.Any() && _isConnected)
    {
        <div class="space-y-3">
            @foreach (var item in _leituras)
            {
                var percentual = (item.Temperatura / 40) * 100;
                percentual = Math.Min(percentual, 100);
                var corBarra = item.Temperatura > 28 ? "bg-red-500" : (item.Temperatura < 22 ? "bg-blue-500" : "bg-green-500");
                
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="text-gray-400">@item.Hora</span>
                        <span class="text-white font-medium">@item.Temperatura.ToString("F1")°C</span>
                    </div>
                    <div class="w-full bg-gray-800 rounded-full h-6 overflow-hidden">
                        <div class="@corBarra h-full rounded-full transition-all duration-500 flex items-center justify-end pr-2"
                             style="width: @(percentual)%">
                            @if (percentual > 15)
                            {
                                <span class="text-white text-[10px] font-bold">@item.Temperatura.ToString("F1")°C</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="flex justify-between items-center mt-4 pt-3 border-t border-gray-800">
            <div class="flex gap-4">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                    <span class="text-xs text-gray-400">Normal (22-28)</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                    <span class="text-xs text-gray-400">Alerta (&gt;28)</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                    <span class="text-xs text-gray-400">Baixa (&lt;22)</span>
                </div>
            </div>
        </div>
    }
    else if (!_isConnected)
    {
        <div class="h-64 flex items-center justify-center">
            <div class="text-center text-gray-500">
                <i class="fa-solid fa-wifi text-4xl mb-2 opacity-30"></i>
                <p>Sem conexão com o servidor</p>
                <p class="text-xs mt-2">Tentando reconectar...</p>
            </div>
        </div>
    }
    else
    {
        <div class="h-64 flex items-center justify-center">
            <div class="text-center text-gray-500">
                <i class="fa-solid fa-chart-simple text-4xl mb-2 opacity-30"></i>
                <p>Aguardando dados...</p>
            </div>
        </div>
    }
</div>

@code {
    private List<LeituraItem> _leituras = new();
    private bool _isConnected = false;
    private Timer? _timer;
    
    protected override async Task OnInitializedAsync()
    {
        LeituraService.OnConnected += OnConnectedHandler;
        LeituraService.OnDisconnected += OnDisconnectedHandler;
        LeituraService.OnNovaLeitura += OnNovaLeitura;
        
        await CarregarDadosIniciais();
        await LeituraService.StartAsync();
        
        _isConnected = LeituraService.IsConnected;
        
        _timer = new Timer(_ =>
        {
            var currentStatus = LeituraService.IsConnected;
            if (_isConnected != currentStatus)
            {
                _isConnected = currentStatus;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
        
        StateHasChanged();
    }
    
    private void OnConnectedHandler()
    {
        _isConnected = true;
        Console.WriteLine("ChartSection: Conectado ao SignalR");
        _ = Task.Run(async () => await CarregarDadosIniciais());
        InvokeAsync(StateHasChanged);
    }
    
    private void OnDisconnectedHandler(string? error)
    {
        _isConnected = false;
        Console.WriteLine($"ChartSection: Desconectado - {error}");
        _leituras.Clear();
        InvokeAsync(StateHasChanged);
    }
    
    private async Task CarregarDadosIniciais()
    {
        try
        {
            Console.WriteLine("Carregando dados do gráfico...");
            var leituras = await Http.GetFromJsonAsync<List<Leitura>>("api/leituras");
            
            if (leituras != null && leituras.Any())
            {
                var ultimas = leituras
                    .OrderByDescending(x => x.Timestamp)
                    .Take(6)
                    .Reverse()
                    .ToList();
                
                _leituras = ultimas.Select(x => new LeituraItem
                {
                    Hora = x.Timestamp.ToString("HH:mm"),
                    Temperatura = x.Temperatura
                }).ToList();
            }
            else
            {
                _leituras.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dados: {ex.Message}");
            _leituras.Clear();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private void OnNovaLeitura(Leitura leitura)
    {
        if (_isConnected)
        {
            _leituras.Add(new LeituraItem
            {
                Hora = leitura.Timestamp.ToString("HH:mm"),
                Temperatura = leitura.Temperatura
            });
            
            if (_leituras.Count > 6)
            {
                _leituras.RemoveAt(0);
            }
            
            InvokeAsync(StateHasChanged);
        }
    }
    
    public void Dispose()
    {
        _timer?.Dispose();
        LeituraService.OnConnected -= OnConnectedHandler;
        LeituraService.OnDisconnected -= OnDisconnectedHandler;
        LeituraService.OnNovaLeitura -= OnNovaLeitura;
    }
    
    private class LeituraItem
    {
        public string Hora { get; set; } = "";
        public double Temperatura { get; set; }
    }
}