@* AlertasStats.razor*@
@inject AlertasService AlertasService
@implements IDisposable

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
    <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/40 rounded-2xl p-4 text-center border border-gray-700 hover:border-blue-500/30 transition-all">
        <p class="text-2xl font-bold text-white">@total</p>
        <p class="text-gray-500 text-xs">Total de alertas</p>
    </div>
    <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/40 rounded-2xl p-4 text-center border border-gray-700 hover:border-red-500/30 transition-all">
        <p class="text-2xl font-bold text-red-400">@criticosNaoLidos</p>
        <p class="text-gray-500 text-xs">Críticos não lidos</p>
    </div>
    <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/40 rounded-2xl p-4 text-center border border-gray-700 hover:border-yellow-500/30 transition-all">
        <p class="text-2xl font-bold text-yellow-400">@amarelos</p>
        <p class="text-gray-500 text-xs">Atenção</p>
    </div>
    <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/40 rounded-2xl p-4 text-center border border-gray-700 hover:border-green-500/30 transition-all">
        <p class="text-2xl font-bold text-green-400">@lidos</p>
        <p class="text-gray-500 text-xs">Resolvidos</p>
    </div>
</div>

@code {
    private int total;
    private int lidos;
    private int criticosNaoLidos;
    private int amarelos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEstatisticas();
        
        AlertasService.OnEstatisticasAtualizadas += OnEstatisticasAtualizadas;
        AlertasService.OnNovoAlerta += OnNovoAlerta;
        AlertasService.OnAlertaLido += OnAlertaLido;
        
        _ = AlertasService.StartAsync();
    }

    private async Task CarregarEstatisticas()
    {
        try
        {
            var alertas = await AlertasService.GetAllAsync();
            total = alertas.Count;
            lidos = alertas.Count(a => a.Lida);
            criticosNaoLidos = alertas.Count(a => !a.Lida && a.Gravidade == 3);
            amarelos = alertas.Count(a => !a.Lida && a.Gravidade == 1);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar estatísticas: {ex.Message}");
        }
    }

    private void OnEstatisticasAtualizadas(AlertasStatsModels stats)
    {
        total = stats.Total;
        lidos = stats.Lidos;
        criticosNaoLidos = stats.CriticosNaoLidos;
        amarelos = stats.Amarelos;
        StateHasChanged();
    }

    private void OnNovoAlerta(AlertaDto alerta)
    {
        _ = CarregarEstatisticas();
    }

    private void OnAlertaLido(Guid id)
    {
        _ = CarregarEstatisticas();
    }

    public void Dispose()
    {
        AlertasService.OnEstatisticasAtualizadas -= OnEstatisticasAtualizadas;
        AlertasService.OnNovoAlerta -= OnNovoAlerta;
        AlertasService.OnAlertaLido -= OnAlertaLido;
        _ = AlertasService.StopAsync();
    }
}