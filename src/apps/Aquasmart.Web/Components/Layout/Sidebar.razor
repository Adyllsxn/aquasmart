<!-- Sidebar Industrial Premium - SEM LINHA -->
<aside class="@($"fixed top-0 left-0 z-50 h-screen bg-black transition-all duration-300 flex flex-col select-none {(IsCollapsed ? "w-24" : "w-80")}")">
    
    <!-- TOPO COM PADDING DINÂMICO (SÓ AQUI) -->
    <div class="@(IsCollapsed ? "w-full py-8 px-2" : "w-full py-8 px-8") flex items-center justify-between">
        <a href="/aquasmart/" class="flex items-center gap-4 group cursor-pointer">
            <div class="w-10 h-10 flex items-center justify-center">
                <img src="assets/logo.svg" alt="Aquasmart" class="w-full h-full object-contain brightness-100 group-hover:scale-105 transition-all duration-300" />
            </div>
            @if (!IsCollapsed)
            {
                <span class="text-sm font-black tracking-[0.2em] uppercase text-white">
                    Aquasmart
                </span>
            }
        </a>
        
        <!-- BOTÃO COLLAPSO BONITO -->
        <button @onclick="OnToggle" 
                class="w-10 h-10 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-white/5 transition-all duration-300 group">
            <i class="fa-solid @(IsCollapsed ? "fa-bars-staggered" : "fa-bars") text-xl group-hover:scale-110 transition-transform duration-300"></i>
        </button>
    </div>

    <!-- NAVEGAÇÃO (MANTÉM IGUAL, SEM MUDANÇAS) -->
    <nav class="flex-1 flex flex-col justify-center w-full gap-2 px-6">
        
        <!-- Dashboard -->
        <NavLink href="/aquasmart/" Match="NavLinkMatch.All" 
                 class="flex items-center gap-4 px-4 py-3 text-neutral-400 hover:text-white hover:bg-white/5 transition-all duration-200 group w-full" 
                 ActiveClass="!bg-white/5 !text-white !border-l-4 !border-l-blue-500">
            <div class="w-5 flex justify-center">
                <i class="fa-solid fa-chart-line text-lg group-hover:scale-105 transition-transform duration-200"></i>
            </div>
            @if (!IsCollapsed) 
            { 
                <span class="text-sm font-medium tracking-wide">Dashboard</span> 
            }
        </NavLink>
        
        <!-- Alertas -->
        <NavLink href="/aquasmart/alertas" 
                 class="flex items-center gap-4 px-4 py-3 text-neutral-400 hover:text-white hover:bg-white/5 transition-all duration-200 group w-full" 
                 ActiveClass="!bg-white/5 !text-white !border-l-4 !border-l-blue-500">
            <div class="w-5 flex justify-center">
                <i class="fa-solid fa-bell text-lg group-hover:scale-105 transition-transform duration-200"></i>
            </div>
            @if (!IsCollapsed) 
            { 
                <span class="text-sm font-medium tracking-wide">Alertas</span> 
            }
        </NavLink>
        
        <!-- Histórico -->
        <NavLink href="/aquasmart/historico" 
                 class="flex items-center gap-4 px-4 py-3 text-neutral-400 hover:text-white hover:bg-white/5 transition-all duration-200 group w-full" 
                 ActiveClass="!bg-white/5 !text-white !border-l-4 !border-l-blue-500">
            <div class="w-5 flex justify-center">
                <i class="fa-solid fa-clock-rotate-left text-lg group-hover:scale-105 transition-transform duration-200"></i>
            </div>
            @if (!IsCollapsed) 
            { 
                <span class="text-sm font-medium tracking-wide">Histórico</span> 
            }
        </NavLink>
        
    </nav>

    <!-- BASE VAZIA -->
    <div class="w-full h-16"></div>

</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}