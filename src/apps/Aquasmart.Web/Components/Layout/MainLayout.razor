@inherits LayoutComponentBase

<div class="h-screen bg-gray-950 overflow-hidden">
    <div class="flex h-full">
        <Sidebar IsCollapsed="_sidebarCollapsed" OnToggle="ToggleSidebar" />

        <div class="transition-all duration-300 flex-1 h-full overflow-y-auto"
             style="margin-left: @(_sidebarCollapsed ? "96px" : "300px")">
            <main class="p-4 md:p-8">
                <div class="max-w-7xl mx-auto">
                    @Body
                </div>
            </main>
        </div>
    </div>
</div>

@code {
    private bool _sidebarCollapsed = false;
    
    private void ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        StateHasChanged();
    }
}